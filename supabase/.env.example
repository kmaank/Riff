# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase Project
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_... # Test mode key
STRIPE_WEBHOOK_SECRET=whsec_... # From Stripe webhook endpoint

# Stripe Price IDs (from Stripe Dashboard)
STRIPE_PRICE_ID_STARTER=price_... # $9.99/month
STRIPE_PRICE_ID_PRO=price_... # $19.99/month
STRIPE_PRICE_ID_LIFETIME=price_... # $149 one-time

# Managed Groq API Keys (one per tier)
# These are the keys Riff uses for paid users (never exposed to client)
GROQ_API_KEY_STARTER=gsk_...
GROQ_API_KEY_PRO=gsk_...
GROQ_API_KEY_LIFETIME=gsk_...

# Encryption Secret (generate with: openssl rand -hex 32)
# Used for encrypting managed API keys in database
ENCRYPTION_SECRET=your-32-byte-hex-string-here

# HMAC Secret (generate with: openssl rand -hex 32)
# Used for request signing verification
HMAC_SECRET=your-32-byte-hex-string-here
