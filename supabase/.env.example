# Copy this file to .env and fill in your actual values.
# Edge Functions also read these names from `supabase secrets`.

# Supabase Project
SUPABASE_URL=https://yrsviodciuepunofxoja.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Alias accepted by Edge Functions
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...
# Aliases
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_LIFETIME=price_...

# Managed Groq keys (paid users; never shipped to the client)
GROQ_API_KEY=gsk_...
GROQ_API_KEY_STARTER=gsk_...
GROQ_API_KEY_PRO=gsk_...
GROQ_API_KEY_LIFETIME=gsk_...
MANAGED_GROQ_API_KEY=gsk_...

# HMAC secret for proxy request signing (openssl rand -hex 32)
HMAC_SECRET=your-32-byte-hex-string-here
# AES-256-GCM wrap for user BYOK Groq keys stored in user_groq_keys
# openssl rand -hex 32
ENCRYPTION_SECRET=your-32-byte-hex-string-here
API_KEY_WRAP_SECRET=your-32-byte-hex-string-here

APP_URL=riff://
